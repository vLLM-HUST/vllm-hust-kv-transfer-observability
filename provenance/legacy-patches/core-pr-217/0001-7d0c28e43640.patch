 vllm/v1/core/sched/scheduler.py       |  5 +++++
 vllm/v1/kv_offload/cpu/manager.py     |  6 ++++++
 vllm/v1/kv_offload/cpu/npu_worker.py  | 19 +++++++++++++++++++
 vllm/v1/kv_offload/tiering/manager.py |  8 ++++++++
 5 files changed, 52 insertions(+)
 create mode 100644 vllm/v1/b134_events.py

diff --git a/vllm/v1/b134_events.py b/vllm/v1/b134_events.py
new file mode 100644
index 00000000000..f40a60c8a1b
--- /dev/null
+++ b/vllm/v1/b134_events.py
@@ -0,0 +1,14 @@
+"""B134 event emitter (minimal, observe-only instrumentation)."""
+import os
+import time
+
+_FILE = os.environ.get("B134_EVENTS_FILE", "")
+
+if _FILE:
+    _f = open(_FILE, "a", buffering=1)  # line-buffered
+
+
+def emit(event: str, req_id: str, extra: str = "") -> None:
+    if not _FILE:
+        return
+    _f.write(f"{time.monotonic():.6f}\t{event}\t{req_id}\t{extra}\n")
