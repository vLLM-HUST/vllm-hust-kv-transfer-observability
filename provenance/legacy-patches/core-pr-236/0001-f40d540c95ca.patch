+def test_close_racing_begin_cannot_leave_a_new_attempt():
+    close_entered = threading.Event()
+    close_release = threading.Event()
+
+    class BlockingCloseSink(NoopEvidenceSink):
+        def close(self, open_attempts, evidence_disabled):
+            close_entered.set()
